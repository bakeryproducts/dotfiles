{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "small_model": "google/gemini-3.5-flash",
  "share": "disabled",
  "experimental": {
    "mcp_timeout": 600000
  },
  "compaction": {
    "auto": false
  },
  "formatter": false,
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "asker": {
      "color": "#b8bb26"
    },
    "builder": {
      "color": "#d79921"
    },
    "inspector": {
      "color": "#83a598"
    },
    "fixer": {
      "color": "#d3869b"
    },
    "bridge": {
      "color": "#fb4934",
      "disable": true
    }
  },
  "mcp": {
    "vault": {
      "type": "remote",
      "enabled": false,
      "url": "http://localhost:3000/sse"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "adk": {
        "type": "remote",
        "url": "http://localhost:3001/sse",
        "enabled": false
    },
    "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browserUrl", "http://localhost:9222"],
        "enabled": false
    },
    "call-human": {
      "type": "remote",
      "url": "{env:CALL_HUMAN_URL}",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CALL_HUMAN_API_KEY}"
      },
      "enabled": false
    }
  },

  "tools": {
    "gmail_*": false
  },
  "provider": {
      "bedrock-fable": {
        "npm": "@ai-sdk/amazon-bedrock",
        "name": "Bedrock (Fable / data-share)",
        "options": {
          "apiKey": "{env:AWS_BEARER_TOKEN_BEDROCK_FABLE}",
          "region": "us-east-1"
        },
        "models": {
          "global.anthropic.claude-fable-5": { "name": "Claude Fable 5" }
        }
      },
    "pallie": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Pallie",
      "options": {
        "baseURL": "http://localhost:8200/v1",
        "apiKey": "{env:PALLIE_API_KEY}"
      },
      "models": {
        "cal001": {
          "name": "Pallie cal001",
          "attachment": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
