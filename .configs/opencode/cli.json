{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "light"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": false,
  "attention": {
    "sound": false,
    "volume": 0.6
  },
  "keybinds": {
    "session.export": "none",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "model.list": "<leader>k",
    "mcp.list": "<leader>m"
  }
}
