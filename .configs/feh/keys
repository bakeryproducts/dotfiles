# Navigation between images
next_img l
prev_img h

# Zoom
zoom_in k
zoom_out j

# Scroll (Shift+hjkl or Right Alt + hjkl; keyd maps control+j/k to Down/Up)
scroll_left H C-h
scroll_right L C-l
scroll_up K Up C-k
scroll_down J Down C-j

# Jump
jump_first g
jump_last G
jump_fwd C-f
jump_back C-b

# Unbind conflicting defaults
toggle_pause
toggle_keep_vp

