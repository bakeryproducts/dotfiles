# Navigation between images
next_img l
prev_img h

# Zoom
zoom_in k
zoom_out j

# Scroll (when zoomed in)
scroll_left H
scroll_right L
scroll_up K
scroll_down J

# Scroll with Right Alt (keyd remaps it to Ctrl) + hjkl
scroll_left C-h
scroll_right C-l
scroll_up C-k
scroll_down C-j

# Jump
jump_first g
jump_last G
jump_fwd C-f
jump_back C-b

# Unbind conflicting defaults
toggle_pause
toggle_keep_vp
